{# Header / navigation / footer pieces shared by every page. #}

{% macro navLogo() -%}
<div class="nav-logo__logo-cont"><a href="/"><figure class="nav-logo__nav-logo"><img src="/img/common/logo-full.png" alt="" height="90" width="62"></figure></a></div>
{%- endmacro %}

{% macro cartLink(variant) -%}
{%- set fill = "#f99d1c" if variant == "orange" else "#fff" -%}
<div class="Header__summary snipcart-summary snipcart-checkout button-m__cart-link"><div class="cart-link__cart-top"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" class="cart-link__icon button-m__cart-link"><path fill="{{ fill }}" d="M352 160v-32C352 57.42 294.579 0 224 0 153.42 0 96 57.42 96 128v32H0v272c0 44.183 35.817 80 80 80h288c44.183 0 80-35.817 80-80V160h-96zm-192-32c0-35.29 28.71-64 64-64s64 28.71 64 64v32H160v-32zm160 120c-13.255 0-24-10.745-24-24s10.745-24 24-24 24 10.745 24 24-10.745 24-24 24zm-192 0c-13.255 0-24-10.745-24-24s10.745-24 24-24 24 10.745 24 24-10.745 24-24 24z"></path></svg><span class="cart-link__total-items snipcart-total-items {{ variant }}"></span></div></div>
{%- endmacro %}

{% macro search() -%}
<div class="search__search-cont" data-search><button type="button" data-search-toggle><svg stroke="currentColor" fill="currentColor" stroke-width="0" version="1.1" viewBox="0 0 16 16" height="1.4rem" width="1.4rem" xmlns="http://www.w3.org/2000/svg"><path d="M15.504 13.616l-3.79-3.223c-0.392-0.353-0.811-0.514-1.149-0.499 0.895-1.048 1.435-2.407 1.435-3.893 0-3.314-2.686-6-6-6s-6 2.686-6 6 2.686 6 6 6c1.486 0 2.845-0.54 3.893-1.435-0.016 0.338 0.146 0.757 0.499 1.149l3.223 3.79c0.552 0.613 1.453 0.665 2.003 0.115s0.498-1.452-0.115-2.003zM6 10c-2.209 0-4-1.791-4-4s1.791-4 4-4 4 1.791 4 4-1.791 4-4 4z"></path></svg></button><input placeholder="Search page titles" type="text" class="searchInput searchHidden" data-search-input value=""></div>
{%- endmacro %}

{% macro ctaButton(link, text, placement) -%}
<span class="cta-button__btn"><a href="{{ link }}" class="cta-button__btn-link {{ placement }}">{{ text }}</a></span>
{%- endmacro %}

{% macro navMain(navLinks) -%}
<nav class="nav-main__desktop-nav">{{ navLogo() }}<div class="nav-main__row"><ul class="nav-main__menu">
{%- for link in navLinks -%}
{%- if link.length > 1 -%}
<li><a href="{{ link[0].url }}">{{ link[0].name }}</a><ul>{% for sub in link[1] %}{% if not sub.mobileOnly %}<li><a href="{{ sub.url }}">{{ sub.name }}</a></li>{% endif %}{% endfor %}</ul></li>
{%- else -%}
<li><a href="{{ link[0].url }}">{{ link[0].name }}</a></li>
{%- endif -%}
{%- endfor -%}
</ul><div class="nav-main__icon-row"><div class="nav-main__icon-cont">{{ search() }}</div><div class="nav-main__icon-cont">{{ cartLink() }}</div></div></div></nav>
{%- endmacro %}

{% macro navSub(navLinks) -%}
<div class="nav-sub__nav-cont" data-drawer-root><div class="nav-sub__drawer" data-drawer><div class="nav-sub__drawer-overlay" data-drawer></div><div class="nav-sub__drawer-content" data-drawer><div class="nav-sub__close-btn" data-drawer-toggle>X</div><ul class="nav-sub__menu">
{%- for link in navLinks -%}
{%- set i = loop.index0 -%}
{%- if link.length > 1 -%}
<li><label for="m{{ i }}">{{ link[0].name }}</label><input type="checkbox" id="m{{ i }}"><ul>{% for sub in link[1] %}<li><a href="{{ sub.url }}">{{ sub.name }}</a></li>{% endfor %}</ul></li>
{%- else -%}
<li><a href="{{ link[0].url }}">{{ link[0].name }}</a></li>
{%- endif -%}
{%- endfor -%}
</ul>{{ search() }}</div></div><div class="nav-sub__nav"><div class="nav-sub__nav-inner">{{ ctaButton("https://www.crowdfunder.co.uk/apf/step/basics/7nPGOrqW", "Fundraise for us", "header") }}{{ ctaButton("https://goldyouth.org/donation/", "Donate", "header") }}</div><div class="nav-sub__mobile-nav">{{ navLogo() }}<div class="nav-sub__nav-icons"><div class="nav-sub__nav-icons-inner"><div class="nav-sub__inner-flex">{{ ctaButton("https://www.crowdfunder.co.uk/apf/step/basics/7nPGOrqW", "Fundraise for us", "header") }}</div>{{ ctaButton("https://goldyouth.org/donation/", "Donate", "header") }}</div><div class="nav-sub__icons-cont">{{ cartLink("orange") }}</div><div class="nav-sub__icons-cont"><svg type="primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="nav-sub__mobile-nav-icon" data-drawer-toggle><title>Hamburger</title><path d="M24,19v2a1,1,0,0,1-1,1H1a.94.94,0,0,1-.7-.3A1,1,0,0,1,0,21V19a1,1,0,0,1,.3-.7A.94.94,0,0,1,1,18H23a1,1,0,0,1,1,1Zm0-8v2a.94.94,0,0,1-.3.7,1,1,0,0,1-.7.3H1a.94.94,0,0,1-.7-.3A.94.94,0,0,1,0,13V11a.94.94,0,0,1,.3-.7A.94.94,0,0,1,1,10H23a1,1,0,0,1,.7.3A.94.94,0,0,1,24,11Zm0-8V5a1,1,0,0,1-1,1H1a.94.94,0,0,1-.7-.3A1,1,0,0,1,0,5V3a.94.94,0,0,1,.3-.7A.94.94,0,0,1,1,2H23a1,1,0,0,1,.7.3A.94.94,0,0,1,24,3Z" fill="#f99d1c"></path></svg></div></div></div></div></div>
{%- endmacro %}

{% macro ourWorkTiles(displayHeading) -%}
{%- set projects = [
  { id: "village", name: "Sam's Village", src: "/sams-village", fullWidth: true },
  { id: "water", name: "Water", src: "/water", fullWidth: false },
  { id: "health", name: "Health", src: "/health", fullWidth: false },
  { id: "education", name: "Education", src: "/education", fullWidth: true },
  { id: "environment", name: "Environment", src: "/environment", fullWidth: false },
  { id: "celebrate", name: "Celebrate & Give", src: "/celebrate-and-give", fullWidth: false }
] -%}
<section class="our-work-tiles__container"><div>{% if displayHeading %}<h2 class="our-work-tiles__heading">Our work</h2>{% endif %}<div class="our-work-tiles__tile-cont">
{%- for p in projects -%}
<div class="our-work-tiles__tile {{ 'fullWidth' if p.fullWidth else 'halfSize' }}"><a href="{{ p.src }}" class="{{ p.id }}"><div class="our-work-tiles__overlay"><span class="our-work-tiles__sub-heading">{{ p.name }} </span></div></a></div>
{%- endfor -%}
</div></div></section>
{%- endmacro %}

{% macro divider() -%}
<div class="divider__container"><svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none"><path d="M985.66,92.83C906.67,72,823.78,31,743.84,14.19c-82.26-17.34-168.06-16.33-250.45.39-57.84,11.73-114,31.07-172,41.86A600.21,600.21,0,0,1,0,27.35V120H1200V95.8C1132.19,118.92,1055.71,111.31,985.66,92.83Z" class="shape-fill"></path></svg></div>
{%- endmacro %}
