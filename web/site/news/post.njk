---js
{
  layout: "layouts/base.njk",
  pagination: { data: "db.news", size: 1, alias: "doc" },
  permalink: (data) => `/news/${data.doc.slug.current}.html`,
  eleventyComputed: {
    title: (data) => data.doc.title,
    description: (data) => data.doc.description,
    canonical: (data) => `/news/${data.doc.slug.current}`,
  },
}
---
{%- from "components/content.njk" import hero, markdown -%}
{%- from "components/posts.njk" import eventSummary, postSections -%}
<article><section class="articleInner"><h1>{{ doc.title }}</h1></section>
{%- if doc.photo and not doc.hideHeaderPhoto -%}<div>{{ hero(doc.photo) }}</div>{%- endif -%}
<section class="articleInner">{% if doc.body %}{{ markdown(doc.body) }}{% endif %}</section>
{%- if doc.event -%}<section class="articleInner">{{ eventSummary(newsEvents, doc.event, true, true) }}</section>{%- endif -%}
<section class="articleInner"><section class="page-news-slug__container">{{ postSections(doc.content, db.videos, "page-news-slug") }}</section></section></article>
